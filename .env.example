# Copie para .env e substitua pelos valores do seu ambiente.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ecommerce_esportivo
REDIS_URL=redis://localhost:6379/0
SUPABASE_URL=https://seu-projeto.supabase.co
# Chave publishable (sb_publishable_...) ou anon; nunca service_role/secret.
SUPABASE_KEY=chave-publica-ficticia
# UUIDs do Authentication > Users, separados por vírgula. Vazio nega todos.
ADMIN_USER_IDS=00000000-0000-0000-0000-000000000000
# false para HTTP local; true quando servido por HTTPS.
COOKIE_SECURE=false
